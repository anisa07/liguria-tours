---
import IntlBaseLayout from "@/layouts/IntlBaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import Section from "@/components/layout/Section.astro";
import TourSchema from "@/components/content/TourSchema.astro";
import SocialShare from "@/components/interactive/SocialShare.astro";
import { getPageTranslations } from "@/i18n/i18n";
import type { Locale } from "@/i18n/config";
import { getCollection } from "astro:content";
import { Check, ChevronRight } from "@lucide/astro";

export interface Props {
  locale: Locale;
}

// Get params from URL
const { slug } = Astro.params;

// Get locale from URL
const pathSegments = Astro.url.pathname.split("/").filter(Boolean);
const locale = (pathSegments[0] as Locale) || "ru";

// Get the translation function for this page
const { t } = await getPageTranslations(locale, ["common", "ui", "tours"]);

// Load tours from content collection
const toursCollection = await getCollection("italianToursGallery");
const toursData = toursCollection && toursCollection[0]?.data;
const allTours = toursData?.tours || [];

// Find the tour by slug
const tour = allTours.find((t) => t.slug === slug);

// If tour not found, return 404
if (!tour) {
  return Astro.redirect("/404");
}

// Get related tours (same categories, different from current)
const getRelatedTours = (currentTour: any, allTours: any[], limit = 3) => {
  return allTours
    .filter((t) => 
      t.slug !== currentTour.slug && 
      t.categories.some((cat: string) => currentTour.categories.includes(cat))
    )
    .slice(0, limit);
};

const relatedTours = getRelatedTours(tour, allTours, 3);

// Static paths generation for pre-rendering
export async function getStaticPaths() {
  const toursCollection = await getCollection("italianToursGallery");
  const toursData = toursCollection && toursCollection[0]?.data;
  const tours = toursData?.tours || [];

  const locales = ["ru"];

  const paths = [];

  for (const locale of locales) {
    for (const tour of tours) {
      paths.push({
        params: { slug: tour.slug },
        props: { locale },
      });
    }
  }

  return paths;
}
---

<IntlBaseLayout
  locale={locale}
  pageNS={["common", "ui", "tours"]}
  seo={{
    title: `${tour.title} - ${t("tours.title", "Туры по Италии")}`,
    description: tour.description,
    canonical: `${Astro.site}tour/${tour.slug}`,
    openGraph: {
      basic: {
        title: tour.title,
        type: "article",
        image: "/images/og-image.jpg",
        url: `${Astro.site}tour/${tour.slug}`,
      },
      optional: {
        description: tour.description,
        siteName: "Туры по Лигурии",
      },
    },
  }}
>
  <!-- Add structured data for this tour -->
  <TourSchema
    name={tour.title}
    description={tour.fullDescription || tour.description}
    url={`${Astro.site}tour/${tour.slug}`}
    image={tour.images && tour.images[0] ? `${Astro.site}${tour.images[0].image}` : undefined}
    duration={tour.duration}
    category={tour.categories}
    location={{
      name: "Лигурия",
      address: "Лигурия, Италия",
      geo: {
        latitude: 44.4056,
        longitude: 8.9463,
      }
    }}
    offers={{
      price: "80",
      currency: "EUR",
      availability: "https://schema.org/InStock",
    }}
  />
  <Section class="py-12">
    <Container>
      <!-- Title -->
      <div class="mb-12">
        <h1 class="text-3xl md:text-4xl font-bold text-center">{tour.title}</h1>
      </div>

      <!-- Tour Content -->
      <div class="grid lg:grid-cols-2 gap-12">
        <!-- Images Section -->
        <div>
          <!-- Main Image -->
          <div class="aspect-[4/3] rounded-2xl overflow-hidden mb-4">
            <img
              src={tour.images[0]?.image?.src}
              alt={tour.title}
              class="w-full h-full object-cover"
            />
          </div>

          <!-- Small Images -->
          {
            tour.images && tour.images.length > 1 && (
              <div class="grid grid-cols-2 gap-4">
                {tour.images.slice(1, 3).map((imageObj, index) => (
                  <div class="aspect-[4/3] rounded-lg overflow-hidden">
                    <img
                      src={imageObj.image.src}
                      alt={imageObj.alt || `${tour.title} ${index + 2}`}
                      class="w-full h-full object-cover hover:scale-105 transition-transform cursor-pointer"
                    />
                  </div>
                ))}
              </div>
            )
          }
        </div>

        <!-- Content Section -->
        <div class="space-y-8">
          <!-- Duration -->
          <div class="flex flex-wrap gap-6">
            {
              tour.duration && (
                <div class="flex items-center gap-2">
                  <span class="text-sm text-foreground/70">
                    {t("tours.duration", "Продолжительность")}:
                  </span>
                  <span class="font-semibold">{tour.duration}</span>
                </div>
              )
            }
          </div>

          <!-- Book Now Button -->
          <div class="pt-4">
            <a
              href="/about-me?contact=true"
              class="inline-block bg-primary hover:bg-primary/90 text-primary-foreground px-6 py-3 rounded-full font-semibold text-lg transition-colors"
            >
              {t("tours.book_now", "Забронировать")}
            </a>
          </div>

          <!-- Social Share Section -->
          <div class="pt-6">
            <SocialShare 
              locale={locale}
              url={`${Astro.site}tour/${tour.slug}`}
              title={tour.title}
              description={tour.description}
              showLabels={true}
            />
          </div>
        </div>
      </div>

      <!-- Description Section - Full Width -->
      <div class="mt-16">
        <div class="max-w-4xl mx-auto">
          <div id="description-container">
            <p class="text-foreground/80 leading-relaxed text-lg text-justify">
              <span id="description-short">
                {
                  tour.fullDescription.length > 500
                    ? tour.fullDescription.substring(0, 500) + "..."
                    : tour.fullDescription
                }
              </span>
              <span id="description-full" class="hidden">
                {tour.fullDescription}
              </span>
            </p>
            {
              tour.fullDescription.length > 500 && (
                <button
                  id="toggle-description"
                  class="mt-4 text-primary hover:text-primary/80 font-semibold transition-colors"
                >
                  <span id="show-more-text">
                    {t("common.show_more", "Показать больше")}
                  </span>
                  <span id="show-less-text" class="hidden">
                    {t("common.show_less", "Показать меньше")}
                  </span>
                </button>
              )
            }
          </div>
        </div>
      </div>

      <!-- Highlights Section - Full Width Below in Columns -->
      {
        tour.points && tour.points.length > 0 && (
          <div class="mt-16">
            <h3 class="text-2xl font-bold mb-8 text-center">
              {t("tours.highlights", "Основные моменты")}
            </h3>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
              {tour.points.map((point) => (
                <div class="flex items-start gap-3 p-4 bg-muted/30 rounded-lg">
                  <Check class="w-5 h-5 text-primary mt-0.5 flex-shrink-0" />
                  <span class="text-foreground/80">{point}</span>
                </div>
              ))}
            </div>
          </div>
        )
      }

      <!-- Related Tours Section -->
      {
        relatedTours.length > 0 && (
          <div class="mt-20">
            <h3 class="text-2xl font-bold mb-8 text-center">
              {t("tours.related", "Похожие туры")}
            </h3>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
              {relatedTours.map((relatedTour) => (
                <a
                  href={`/tour/${relatedTour.slug}`}
                  class="group bg-background border border-border rounded-xl overflow-hidden hover:shadow-lg transition-all duration-300 hover:border-primary/50 flex flex-col h-full"
                >
                  <div class="aspect-[4/3] overflow-hidden">
                    <img
                      src={relatedTour.images[0]?.image?.src}
                      alt={relatedTour.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                  </div>
                  <div class="p-4 flex flex-col flex-grow">
                    <h4 class="font-semibold text-foreground group-hover:text-primary transition-colors mb-2 line-clamp-2 min-h-[3rem] leading-6">
                      {relatedTour.title}
                    </h4>
                    <p class="text-sm text-muted-foreground line-clamp-2 mb-3 flex-grow min-h-[2.5rem] leading-5">
                      {relatedTour.description}
                    </p>
                    <div class="mt-auto">
                      {relatedTour.duration ? (
                        <div class="flex items-center gap-2 text-xs text-primary truncate">
                          <span class="truncate">Продолжительность: {relatedTour.duration}</span>
                        </div>
                      ) : (
                        <div class="h-4"></div>
                      )}
                    </div>
                  </div>
                </a>
              ))}
            </div>
            
            <!-- Link back to all tours -->
            <div class="text-center mt-8">
              <a
                href="/#tours"
                class="inline-flex items-center gap-2 text-primary hover:text-primary/80 font-semibold transition-colors"
              >
                {t("tours.view_all", "Посмотреть все туры")}
                <ChevronRight class="w-4 h-4" />
              </a>
            </div>
          </div>
        )
      }
    </Container>
  </Section>
</IntlBaseLayout>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Back button functionality
    const backButton = document.getElementById("back-button");
    if (backButton) {
      backButton.addEventListener("click", function () {
        history.back();
      });
    }

    // Description toggle functionality
    const toggleButton = document.getElementById("toggle-description");
    const shortDescription = document.getElementById("description-short");
    const fullDescription = document.getElementById("description-full");
    const showMoreText = document.getElementById("show-more-text");
    const showLessText = document.getElementById("show-less-text");

    if (
      toggleButton &&
      shortDescription &&
      fullDescription &&
      showMoreText &&
      showLessText
    ) {
      toggleButton.addEventListener("click", function () {
        const isShowing = !shortDescription.classList.contains("hidden");

        if (isShowing) {
          // Show full description
          shortDescription.classList.add("hidden");
          fullDescription.classList.remove("hidden");
          showMoreText.classList.add("hidden");
          showLessText.classList.remove("hidden");
        } else {
          // Show short description
          shortDescription.classList.remove("hidden");
          fullDescription.classList.add("hidden");
          showMoreText.classList.remove("hidden");
          showLessText.classList.add("hidden");
        }
      });
    }
  });
</script>
