---
import { Clock } from "@lucide/astro";
import "@/styles/components/tour-card.css";
import { getPageTranslations } from "@/i18n/i18n";
import type { Locale } from "@/i18n/config";

export interface Props {
  tour: {
    id: string;
    title: string;
    image: string;
    duration: string;
    rating?: number;
    href: string;
    description?: string;
  };
  locale?: Locale;
}

const { tour, locale = "ru" } = Astro.props;
const { t } = await getPageTranslations(locale, ["common", "tours"]);
---

<div
  class="tour-card bg-gradient-to-br from-background to-primary/5 rounded-3xl w-full lg:max-w-md min-w-64 shadow-lg hover:shadow-2xl group flex flex-col h-full border-2 border-primary/10 hover:border-primary/30 transition-all duration-300 overflow-hidden"
>
  <a href={tour.href} class="block">
    <div
      class="aspect-video overflow-hidden rounded-t-2xl flex-shrink-0 relative"
    >
      <div
        class="absolute inset-0 bg-gradient-to-t from-background/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10"
      >
      </div>
      <img
        src={tour.image}
        alt={tour.title}
        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
        loading="lazy"
      />
    </div>

    <div class="px-5 pt-5">
      <h3
        class="tour-card-title text-xl font-bold mb-3 group-hover:text-primary transition-colors leading-tight"
      >
        {tour.title}
      </h3>
      {
        tour.description && (
          <p class="text-sm text-foreground/70 mb-4 line-clamp-3 text-justify leading-relaxed">
            {tour.description}
          </p>
        )
      }
    </div>
  </a>

  <div class="flex flex-col flex-grow px-5 pb-5">
    <div class="flex-grow"></div>
    <div
      class="flex justify-between items-center pt-4 border-t-2 border-primary/10"
    >
      <span class="flex items-center gap-2 text-sm text-foreground/80">
        <Clock class="w-4 h-4 text-primary" />
        <span class="font-semibold">{tour.duration}</span>
      </span>
      <a
        href={`/about-me?contact=true&message=${encodeURIComponent(t("tours.book_message", `Я хочу попасть на тур "${tour.title}". Мечтаю увидеть эту красоту.\nНе подскажите сколько стоит экскурсия и в какие дни можно записаться на нее?\nСпасибо!`) || `Я хочу попасть на тур "${tour.title}". Мечтаю увидеть эту красоту.\nНе подскажите сколько стоит экскурсия и в какие дни можно записаться на нее?\nСпасибо!`)}`}
        class="px-4 py-2 rounded-xl bg-gradient-to-r from-primary to-primary/80 text-white hover:text-white focus:text-white text-sm font-bold shadow-lg border-2 border-primary transition-all duration-300 hover:shadow-xl hover:scale-105 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
        title={t("tours.book", "Забронировать")}
        aria-label={`${t("tours.book", "Забронировать")} ${tour.title}`}
      >
        {t("tours.i_want", "Хочу!")}
      </a>
    </div>
  </div>
</div>
