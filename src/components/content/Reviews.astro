---
import Container from "@/components/layout/Container.astro";
import type { Locale } from "@/i18n/config";
import { getPageTranslations } from "@/i18n/i18n";
import { ChevronLeft, ChevronRight, Star, X } from "@lucide/astro";
import reviewsData from "@/content/liguria-reviews.json";

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Get the translation function
const { t } = await getPageTranslations(locale, ["ui"]);

// Load reviews from JSON
const reviews = reviewsData || [];
---

<!-- Reviews Section -->
<section
  id="reviews"
  class="py-24 bg-gradient-to-b from-background via-primary/5 to-background"
>
  <Container size="xl" padding="lg">
    <div class="text-center mb-20">
      <h2 class="text-5xl md:text-6xl font-bold mb-6 tracking-tight">
        <span class="text-primary">Отзывы</span>
        <span class="text-foreground"> моих гостей</span>
      </h2>

      <div
        class="w-32 h-1 bg-gradient-to-r from-transparent via-primary to-transparent mx-auto mb-6"
      >
      </div>
    </div>

    <!-- Reviews Carousel -->
    <div class="relative">
      <!-- Navigation Buttons -->
      <button
        id="reviews-prev"
        class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 md:-translate-x-12 z-10 w-12 h-12 md:w-14 md:h-14 bg-background/80 hover:bg-background border-2 border-primary/20 hover:border-primary rounded-full flex items-center justify-center text-primary transition-all shadow-lg hover:shadow-xl"
        aria-label="Previous reviews"
      >
        <ChevronLeft class="w-6 h-6 md:w-7 md:h-7" />
      </button>

      <button
        id="reviews-next"
        class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 md:translate-x-12 z-10 w-12 h-12 md:w-14 md:h-14 bg-background/80 hover:bg-background border-2 border-primary/20 hover:border-primary rounded-full flex items-center justify-center text-primary transition-all shadow-lg hover:shadow-xl"
        aria-label="Next reviews"
      >
        <ChevronRight class="w-6 h-6 md:w-7 md:h-7" />
      </button>

      <!-- Reviews Container -->
      <div class="overflow-hidden px-4 md:px-8">
        <div
          id="reviews-track"
          class="flex transition-transform duration-500 ease-in-out gap-6"
        >
          {reviews.map((review, index) => (
            <div
              class="review-card flex-shrink-0 w-full md:w-1/2 lg:w-1/3 p-6 bg-background/80 backdrop-blur-sm border border-primary/10 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 cursor-pointer"
              data-index={index}
              data-review-text={review.text}
              data-review-name={review.name}
              data-review-rating={review.rating}
            >
              <!-- Rating Stars -->
              <div class="flex gap-1 mb-4">
                {Array.from({ length: 5 }).map((_, i) => (
                  <Star
                    class={`w-5 h-5 ${
                      i < review.rating
                        ? "fill-primary text-primary"
                        : "fill-transparent text-primary/20"
                    }`}
                  />
                ))}
              </div>

              <!-- Review Text -->
              <p class="text-foreground/90 mb-6 leading-relaxed text-base md:text-lg line-clamp-6">
                "{review.text}"
              </p>

              <!-- Reviewer Name -->
              <div class="flex items-center justify-between pt-4 border-t border-primary/10">
                <span class="font-semibold text-foreground text-lg">
                  {review.name}
                </span>
                <span class="text-xs text-foreground/50">Нажмите для полного текста</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Dots Indicator -->
    <div
      id="reviews-dots"
      class="flex justify-center gap-2 mt-8"
    >
      {Array.from({
        length: Math.ceil(reviews.length / 3),
      }).map((_, i) => (
        <button
          class={`dot w-2 h-2 rounded-full transition-all duration-300 ${
            i === 0
              ? "bg-primary w-8"
              : "bg-primary/30 hover:bg-primary/50"
          }`}
          data-dot-index={i}
          aria-label={`Go to review set ${i + 1}`}
        >
        </button>
      ))}
    </div>
  </Container>

  <!-- Review Modal -->
  <div
    id="review-modal"
    class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4"
  >
    <div
      class="review-modal-content bg-background rounded-2xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-hidden flex flex-col"
    >
      <!-- Modal Header -->
      <div class="flex items-center justify-between p-6 border-b border-primary/10">
        <div class="flex items-center gap-4">
          <div id="modal-rating" class="flex gap-1">
          </div>
          <h3
            id="modal-name"
            class="text-2xl font-bold text-foreground"
          >
          </h3>
        </div>
        <button
          id="close-modal"
          class="w-10 h-10 bg-primary/10 hover:bg-primary/20 rounded-full flex items-center justify-center text-primary transition-all"
          aria-label="Close modal"
        >
          <X class="w-5 h-5" />
        </button>
      </div>

      <!-- Modal Body -->
      <div class="p-6 overflow-y-auto flex-1 custom-scrollbar">
        <p
          id="modal-text"
          class="text-foreground/90 leading-relaxed text-base md:text-lg whitespace-pre-wrap"
        >
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const track = document.getElementById("reviews-track");
    const prevBtn = document.getElementById("reviews-prev");
    const nextBtn = document.getElementById("reviews-next");
    const dots = document.querySelectorAll(".dot");
    const reviewCards = document.querySelectorAll(".review-card");

    if (!track || !prevBtn || !nextBtn || reviewCards.length === 0) return;

    // Calculate how many reviews to show at once based on screen size
    function getReviewsPerView() {
      if (window.innerWidth >= 1024) return 3; // lg: 3 reviews
      if (window.innerWidth >= 768) return 2; // md: 2 reviews
      return 1; // sm: 1 review
    }

    let currentIndex = 0;
    let reviewsPerView = getReviewsPerView();
    const totalReviews = reviewCards.length;
    let totalSets = Math.ceil(totalReviews / reviewsPerView);

    function updateCarousel() {
      if (!track) return;
      const firstCard = reviewCards[0] as HTMLElement;
      const cardWidth = firstCard?.offsetWidth || 0;
      const gap = 24; // gap-6 = 1.5rem = 24px
      // Calculate translateX: move by currentIndex cards
      const translateX = -(currentIndex * (cardWidth + gap));
      track.style.transform = `translateX(${translateX}px)`;

      // Update dots
      const activeDotIndex = Math.floor(currentIndex / reviewsPerView);
      dots.forEach((dot, index) => {
        if (index === activeDotIndex) {
          dot.classList.remove("bg-primary/30", "hover:bg-primary/50");
          dot.classList.add("bg-primary", "w-8");
        } else {
          dot.classList.remove("bg-primary", "w-8");
          dot.classList.add("bg-primary/30", "hover:bg-primary/50");
        }
      });
    }

    function goToNext() {
      const maxIndex = totalReviews - reviewsPerView;
      currentIndex += reviewsPerView;
      
      // Infinite loop: if we go past the end, loop back to start
      if (currentIndex > maxIndex) {
        currentIndex = 0;
      }
      updateCarousel();
    }

    function goToPrev() {
      const maxIndex = totalReviews - reviewsPerView;
      currentIndex -= reviewsPerView;
      
      // Infinite loop: if we go before the start, loop to end
      if (currentIndex < 0) {
        currentIndex = maxIndex;
      }
      updateCarousel();
    }

    // Update reviews per view on resize
    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        const newReviewsPerView = getReviewsPerView();
        if (newReviewsPerView !== reviewsPerView) {
          reviewsPerView = newReviewsPerView;
          totalSets = Math.ceil(totalReviews / reviewsPerView);
          // Adjust current index to stay within bounds
          const maxIndex = totalReviews - reviewsPerView;
          if (currentIndex > maxIndex) {
            currentIndex = maxIndex;
          }
          updateCarousel();
        }
      }, 250);
    });

    // Initialize
    updateCarousel();

    // Event listeners
    nextBtn.addEventListener("click", goToNext);
    prevBtn.addEventListener("click", goToPrev);

    // Dot navigation
    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        currentIndex = index * reviewsPerView;
        updateCarousel();
      });
    });

    // Touch/swipe support
    let touchStartX = 0;
    let touchEndX = 0;

    track.addEventListener("touchstart", (e) => {
      touchStartX = e.changedTouches[0].screenX;
    });

    track.addEventListener("touchend", (e) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    });

    function handleSwipe() {
      const swipeThreshold = 50;
      const diff = touchStartX - touchEndX;

      if (Math.abs(diff) > swipeThreshold) {
        if (diff > 0) {
          // Swipe left - next
          goToNext();
        } else {
          // Swipe right - prev
          goToPrev();
        }
      }
    }

    // Keyboard navigation
    document.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        goToPrev();
      } else if (e.key === "ArrowRight") {
        goToNext();
      }
    });

    // Review Modal functionality
    const modal = document.getElementById("review-modal");
    const modalText = document.getElementById("modal-text");
    const modalName = document.getElementById("modal-name");
    const modalRating = document.getElementById("modal-rating");
    const closeModalBtn = document.getElementById("close-modal");

    if (!modal || !modalText || !modalName || !modalRating || !closeModalBtn) return;

    function openModal(reviewCard: HTMLElement) {
      if (!modal || !modalText || !modalName || !modalRating) return;
      
      const text = reviewCard.getAttribute("data-review-text");
      const name = reviewCard.getAttribute("data-review-name");
      const rating = parseInt(reviewCard.getAttribute("data-review-rating") || "5");

      if (!text || !name) return;

      // Set modal content
      modalText.textContent = `"${text}"`;
      modalName.textContent = name;

      // Set rating stars
      modalRating.innerHTML = "";
      for (let i = 0; i < 5; i++) {
        const star = document.createElementNS("http://www.w3.org/2000/svg", "svg");
        star.setAttribute("viewBox", "0 0 24 24");
        star.setAttribute("fill", i < rating ? "currentColor" : "none");
        star.setAttribute("class", `w-6 h-6 ${
          i < rating
            ? "text-primary fill-primary"
            : "text-primary/20"
        }`);
        star.setAttribute("stroke", "currentColor");
        star.setAttribute("stroke-width", "1.5");
        const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
        path.setAttribute(
          "d",
          "M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
        );
        star.appendChild(path);
        modalRating.appendChild(star);
      }

      // Show modal
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.style.overflow = "";
    }

    // Add click handlers to review cards
    reviewCards.forEach((card) => {
      card.addEventListener("click", (e) => {
        // Don't open modal if clicking on navigation buttons
        if ((e.target as HTMLElement).closest("button")) return;
        openModal(card as HTMLElement);
      });
    });

    // Close modal handlers
    closeModalBtn.addEventListener("click", closeModal);
    modal.addEventListener("click", (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Close on Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.classList.contains("hidden")) {
        closeModal();
      }
    });
  });
</script>

<style>
  .review-card {
    animation: fadeInUp 0.6s ease-out backwards;
  }

  .review-card:nth-child(1) {
    animation-delay: 0.1s;
  }
  .review-card:nth-child(2) {
    animation-delay: 0.15s;
  }
  .review-card:nth-child(3) {
    animation-delay: 0.2s;
  }
  .review-card:nth-child(n + 4) {
    animation-delay: 0.25s;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .line-clamp-6 {
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Smooth scrolling */
  #reviews-track {
    will-change: transform;
  }

  /* Review Modal Styles */
  #review-modal {
    animation: fadeIn 0.2s ease-out;
  }

  .review-modal-content {
    animation: slideUp 0.3s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Custom scrollbar for modal */
  .custom-scrollbar::-webkit-scrollbar {
    width: 8px;
  }

  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(var(--primary), 0.1);
    border-radius: 10px;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(var(--primary), 0.4);
    border-radius: 10px;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(var(--primary), 0.6);
  }
</style>

